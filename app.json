{
  "expo": {
    "name": "Travio",
    "slug": "travio",
    "scheme": "travio",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#05070d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.travio.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Travio does not use the camera yet.",
        "NSMicrophoneUsageDescription": "Travio uses the microphone for voice search.",
        "NSLocationWhenInUseUsageDescription": "Travio may use location later to improve delivery estimates."
      }
    },
    "android": {
      "package": "com.travio.app",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.travio.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Travio uses the microphone for voice search."
        }
      ]
    ]
  }
}
